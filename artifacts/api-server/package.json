{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "audit:soundtap-schedules": "tsx ./src/scripts/audit-soundtap-schedules.ts",
    "audit:schedule-coverage": "tsx ./src/scripts/audit-schedule-coverage.ts",
    "audit:playlist-coverage": "tsx ./src/scripts/audit-playlist-coverage.ts",
    "audit:station-fixtures": "tsx ./src/scripts/audit-station-fixtures.ts",
    "cleanup:station-fixtures": "tsx ./src/scripts/audit-station-fixtures.ts --apply",
    "refresh:soundtap-schedules": "tsx ./src/scripts/refresh-soundtap-schedules.ts",
    "preflight:speech-pilot": "tsx ./src/scripts/run-speech-pilot.ts --preflight",
    "run:speech-pilot": "tsx ./src/scripts/run-speech-pilot.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/lore-attribution": "workspace:*",
    "@workspace/song-enrichment": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^11.0.0",
    "satori": "^0.26.0",
    "spotify-web-api-node": "^5.0.2",
    "zipcodes-us": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/spotify-api": "^0.0.25",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.5"
  }
}
